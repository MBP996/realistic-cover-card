{
  "name": "realistic-cover-card",
  "version": "1.0.0",
  "description": "A highly interactive and visually realistic cover card for Home Assistant.",
  "main": "dist/realistic-cover-card.js",
  "scripts": {
    "build": "rollup -c",
    "release": "rollup --environment release -c",
    "test": "jest",
    "test+debug": "SET DEBUG_MODE=1&&jest",
    "watch": "rollup -c --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/<DEIN_GITHUB_NAME>/realistic-cover-card.git"
  },
  "keywords": [
    "lovelace",
    "cover",
    "card",
    "home-assistant",
    "garage",
    "shutter",
    "blind",
    "animation"
  ],
  "author": "<DEIN_NAME>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/<DEIN_GITHUB_NAME>/realistic-cover-card/issues"
  },
  "homepage": "https://github.com/<DEIN_GITHUB_NAME>/realistic-cover-card#readme",
  "jest": {
    "preset": "ts-jest",
    "runner": "jest-electron/runner",
    "testEnvironment": "jest-electron/environment",
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "verbose": false,
    "setupFilesAfterEnv": [
      "<rootDir>/dist/realistic-cover-card.js"
    ],
    "globals": {
      "ts-jest": {
        "isolatedModules": true
      }
    }
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^9.0.0",
    "@rollup/plugin-typescript": "^6.0.0",
    "@types/jest": "^27.0.3",
    "jest": "^24.9.0",
    "jest-electron": "^0.1.12",
    "rollup": "^2.29.0",
    "rollup-plugin-import-css": "^3.0.2",
    "rollup-plugin-minify-html-literals": "^1.2.6",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-version-injector": "^1.3.3",
    "ts-jest": "^24.3.0",
    "tslib": "^2.0.2",
    "typescript": "^4.0.3"
  },
  "dependencies": {
    "lit": "^2.0.2"
  }
}